{
  "name": "smart-gallery-system",
  "version": "2.0.0",
  "description": "Offline-first presentation system for warehouse meeting screens: drop a file in a folder and every display updates in real time.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:env": "node --env-file=.env backend/server.js",
    "init-admin": "node backend/init-admin.js",
    "init-test-data": "node backend/init-test-data.js",
    "create-test-images": "node backend/utils/create-test-media-sharp.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "websocket",
    "raspberry-pi",
    "edge-computing",
    "offline-first",
    "digital-signage",
    "chokidar",
    "sharp"
  ],
  "author": "Aleks Aleksandrov",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.1.0",
    "chart.js": "^4.4.0",
    "chokidar": "^3.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "tesseract.js": "^6.0.1",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
